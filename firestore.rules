rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: Firebase Auth UID
    // Fields:
    //   - name: string (required, max 100 chars)
    //   - bike: string (optional, max 100 chars)
    //   - mileage: number (optional)
    //   - km: string (optional, max 20 chars)
    //   - phone: string (optional, max 15 chars)
    //   - updatedAt: timestamp (server)
    //
    // Collection: searches
    // Document ID: auto-generated
    // Fields:
    //   - uid: string (required — user UID or 'guest')
    //   - origin: string (max 200 chars)
    //   - destination: string (max 200 chars)
    //   - tripType: string (max 20 chars)
    //   - bike: string (max 100 chars)
    //   - days: number
    //   - vibe: string (max 50 chars)
    //   - ts: timestamp (server)
    //
    // Collection: trips
    // Document ID: auto-generated
    // Fields:
    //   - uid: string (required — user UID)
    //   - origin: string (max 200 chars)
    //   - destination: string (max 200 chars)
    //   - tripType: string (max 20 chars)
    //   - bike: string (max 100 chars)
    //   - days: number
    //   - totalKm: number
    //   - fuelCost: number
    //   - title: string (max 300 chars)
    //   - dayCount: number
    //   - ts: timestamp (server)
    //
    // ===============================================================

    // ── Helper Functions ────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Users Collection ────────────────────────────────────────
    // Users can only read/write their own profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'bike', 'mileage', 'km', 'phone', 'updatedAt', 'tankSize', 'efficiency', 'upi', 'riderPhoto', 'bikePhoto', 'doc_rc', 'doc_license', 'doc_puc', 'doc_insurance', 'activeBikeId'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'bike', 'mileage', 'km', 'phone', 'updatedAt', 'tankSize', 'efficiency', 'upi', 'riderPhoto', 'bikePhoto', 'doc_rc', 'doc_license', 'doc_puc', 'doc_insurance', 'activeBikeId'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
      allow delete: if isOwner(userId);

      // Service Logs Subcollection
      match /service_logs/{logId} {
        allow read, write: if isOwner(userId);
      }

      // Bikes Subcollection
      match /bikes/{bikeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Searches Collection (analytics) ─────────────────────────
    // Anyone can create (even guests), but only owner can read their own
    match /searches/{searchId} {
      allow create: if true
        && request.resource.data.keys().hasOnly(['uid', 'origin', 'destination', 'tripType', 'bike', 'days', 'vibe', 'budget', 'ts'])
        && request.resource.data.origin is string
        && request.resource.data.origin.size() <= 200
        && request.resource.data.destination is string
        && request.resource.data.destination.size() <= 200;
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Trips Collection ────────────────────────────────────────
    // Only logged-in users can create trips, and only read/delete their own
    match /trips/{tripId} {
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'origin', 'destination', 'tripType', 'bike', 'days', 'totalKm', 'fuelCost', 'title', 'dayCount', 'itinerary', 'estimatedFuelCost', 'ts', 'savedAt', 'bikeId'])
        && request.resource.data.origin is string
        && request.resource.data.origin.size() <= 200
        && request.resource.data.destination is string
        && request.resource.data.destination.size() <= 200;
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── Recent Trips Collection (cross-device history sync) ─────
    match /recentTrips/{tripId} {
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'dest', 'type', 'days', 'ts', 'fav'])
        && request.resource.data.dest is string
        && request.resource.data.dest.size() <= 200;
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fav']);
    }

    // ── FCM Tokens Collection (push notifications) ──────────────
    match /fcmTokens/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['token', 'uid', 'updatedAt', 'platform'])
        && request.resource.data.token is string
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    match /bhailink_rides/{rideCode} {
      allow read: if true;
      allow create: if true
        && rideCode.size() == 6;
      allow update: if true;
      allow delete: if false;

      match /members/{memberId} {
        allow read: if true;
        allow write: if true
          && memberId.size() <= 50
          && request.resource.data.id == memberId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 50;
      }

      match /messages/{messageId} {
        allow read: if true;
        allow create: if true
          && messageId.size() <= 100
          && request.resource.data.keys().hasOnly(['id', 'senderId', 'senderName', 'text', 'type', 'ts'])
          && request.resource.data.id == messageId
          && request.resource.data.senderId is string
          && request.resource.data.senderId.size() <= 50
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 50
          && request.resource.data.type in ['text', 'voice', 'sos']
          && request.resource.data.text is string
          && (
               (request.resource.data.type == 'voice' && request.resource.data.text.size() <= 1048576) || 
               (request.resource.data.type != 'voice' && request.resource.data.text.size() <= 500)
             );
        allow update, delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if true;
        allow create: if true
          && request.resource.data.keys().hasOnly(['id', 'desc', 'amount', 'paidBy', 'paidByName', 'splitAmong', 'ts'])
          && request.resource.data.desc is string
          && request.resource.data.desc.size() <= 200
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount < 10000000;
        allow update: if true
          && request.resource.data.keys().hasOnly(['id', 'desc', 'amount', 'paidBy', 'paidByName', 'splitAmong', 'ts'])
          && request.resource.data.desc is string
          && request.resource.data.desc.size() <= 200
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount < 10000000;
        allow delete: if true;
      }

      match /checklist/{itemId} {
        allow read: if true;
        allow create, update: if true
          && request.resource.data.keys().hasOnly(['id', 'text', 'checked', 'addedBy', 'addedByName', 'ts'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200;
        allow delete: if true;
      }
    }

    // ── Fuel Stops (crowdsourced petrol pumps verification) ─────
    match /fuel_stops/{pumpId} {
      allow read: if true;
      allow create, update: if true
        && pumpId.size() <= 120
        && request.resource.data.keys().hasOnly(['name', 'types', 'verifiedCount', 'lastVerified'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.types is list;
    }

    // ── Service Centers (Locator community reviews & specialist tags) ─────
    match /service_centers/{placeId} {
      allow read: if true;
      allow write: if isAuthenticated();

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // ── Buy/Sell Marketplace Listings ───────────────────────────
    match /marketplace_listings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.brand is string
        && request.resource.data.brand.size() <= 50
        && request.resource.data.model is string
        && request.resource.data.model.size() <= 100
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price < 50000000;
      allow update: if isAuthenticated()
        && (resource.data.sellerUid == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedCount']));
      allow delete: if isAuthenticated() && resource.data.sellerUid == request.auth.uid;
    }

    // ── Marketplace Reports ─────────────────────────────────────
    match /marketplace_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    // Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
