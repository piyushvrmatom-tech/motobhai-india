# Moto Bhai India — environment variables
# Copy to backend/.env for local dev (and ensure .env is gitignored).
# In production these are set in the Render dashboard.

# ─── Required ────────────────────────────────────────────────────────────
GEMINI_API_KEY=                  # Google AI Studio → API keys
GMAPS_API_KEY=                   # GCP Console → Maps JavaScript API key (frontend, referrer-restricted)
GOOGLE_ROUTES_API_KEY=           # GCP Console → Routes API key (backend, IP-restricted)
SHEETS_WEBHOOK_URL=              # Apps Script web-app deployment URL
OTP_SECRET=                      # 32+ char random — used to HMAC phone/code in Firestore
JWT_SECRET=                      # 32+ char random — signs auth tokens
MSG91_AUTH_KEY=                  # MSG91 → API → Auth Keys
MSG91_TEMPLATE_ID=               # MSG91 → Flows → published flow id
FIRESTORE_CREDENTIALS_B64=       # base64(service-account-json) — see docs/ONCALL.md

# ─── Defaults (override only for staging) ────────────────────────────────
FRONTEND_ORIGIN=https://motobhai-india.web.app
SHARE_BASE_URL=https://motobhai-india.web.app
ENV=production
LOG_LEVEL=INFO

# ─── Observability ───────────────────────────────────────────────────────
SENTRY_DSN=                      # Sentry → motobhai-api project DSN
SENTRY_TRACES=0.1                # 10% transaction sample rate
